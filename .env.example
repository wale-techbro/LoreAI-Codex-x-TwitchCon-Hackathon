# OpenAI (optional; matching approved lore still has a grounded summary fallback)
OPENAI_API_KEY=
OPENAI_MODEL=

# Supabase (required for multi-creator and production)
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Twitch Creator OAuth (required by the web service and worker)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Exact public callback URL registered in the Twitch Developer Console
TWITCH_REDIRECT_URI=

# Generate a random 32-byte key and store it only in the server environment (64 hex characters)
TWITCH_TOKEN_ENCRYPTION_KEY=
