# OpenAI (optional; without this the demo uses grounded extractive answers)
OPENAI_API_KEY=
OPENAI_MODEL=

# Supabase (optional for local demo; required for shared/deployed persistence)
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Streamer-only moderation access in production (use a long random value)
LORE_ADMIN_SECRET=

# Twitch single-channel EventSub worker
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_ACCESS_TOKEN=
TWITCH_REFRESH_TOKEN=
TWITCH_CHANNEL_LOGIN=
TWITCH_BROADCASTER_USER_ID=
# Optional persistent token-state file path (Render disk example: /var/data/.twitch-token-state.json)
TWITCH_TOKEN_STATE_PATH=
